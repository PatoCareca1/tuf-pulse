{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TUF Pulse",
  "version": "0.1.0",
  "identifier": "dev.tufpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TUF Pulse",
        "width": 400,
        "height": 360,
        "minWidth": 320,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
